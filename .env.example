# BookOne Platform — environment template
#
# D9 / ADR-006: every endpoint below must resolve inside the EU. A service that
# cannot be pinned to an EU region does not get added here until the
# sub-processor register is updated first.

# ---------------------------------------------------------------- database
# Supabase EU (Frankfurt) — pooled connection for apps, direct for migrations
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ------------------------------------------------------------ supabase auth
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# server/worker contexts only — never exposed to a client bundle (ADR-007)
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------- surfaces
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WORKER_URL="http://localhost:8787"
WORKER_PORT="8787"

# ----------------------------------------------------------------- payments
# ADR-010: Stripe behind PaymentAdapter. Test keys only outside prod.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --------------------------------------------------------------- llm access
# ADR-012: consumed exclusively through LlmProvider; EU processing verified
# and registered per provider before a key is ever set here.
LLM_PROVIDER="anthropic"
LLM_API_KEY=""

# ------------------------------------------------------------ observability
SENTRY_DSN=""
LOG_LEVEL="info"
