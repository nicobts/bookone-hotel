# BookOne Platform — environment template
#
# D9 / ADR-006: every endpoint below must resolve inside the EU. A service that
# cannot be pinned to an EU region does not get added here until the
# sub-processor register is updated first.

# ---------------------------------------------------------------- database
# Supabase EU (Frankfurt) — pooled connection for apps, direct for migrations
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# ------------------------------------------------------------ supabase auth
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# server/worker contexts only — never exposed to a client bundle (ADR-007)
SUPABASE_SERVICE_ROLE_KEY=""

# Operator console (apps/admin, ADR-031). The STAFF identity project: a separate
# Supabase project in every deployed environment, and production refuses to
# serve if it is the tenant project above. Locally, point it at the same local
# project; the console says so in a banner. Staff roles live in app_metadata
# (`staff_role`: admin | support), set with the service role, never by the user.
ADMIN_SUPABASE_URL="http://127.0.0.1:54421"
ADMIN_SUPABASE_ANON_KEY=""

# ----------------------------------------------------------------- surfaces
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# apps/api since ADR-034. The name predates the split and is kept so web's
# configuration did not have to change with it.
WORKER_URL="http://localhost:8787"
API_PORT="8787"

# Shared secret for apps/api's /jobs/* endpoints (the worker's before ADR-034). The web app presents it when
# a confirmed booking asks the worker to reflect and to send. Any long random
# string; generate with `openssl rand -base64 32`. Never a default.
WORKER_INTERNAL_TOKEN=""

# ------------------------------------------------------------ notifications
# `log` writes messages to the worker log and transmits nothing. A real ESP is a
# sub-processor of guest personal data (D9): pin the region, update the register
# and sign the DPA before naming one here.
NOTIFICATION_PROVIDER="log"

# --------------------------------------------------------- guest journey
# Signs the stay tokens behind /stay/[token] (ADR-007). A guest holds no
# database session; this signature is the whole of their authorisation, so it
# has no default and must be at least 32 characters. Rotating it invalidates
# every outstanding check-in link at once, which is the intended blunt
# instrument if one is ever leaked in bulk.
STAY_TOKEN_SECRET=""

# ------------------------------------------------------------- payments
# MEMO: NO PAYMENT PROVIDER IS CONNECTED. `mock` is a simulated adapter that
# moves no money (ADR-010, staged like the PMS connector in ADR-008). The
# interface, the policy engine, the ledger and the webhook path are all real.
# The worker refuses to boot with a simulated provider when NODE_ENV=production.
#
# To connect Stripe: complete 04 §0 item 6 (account + Connect Standard +
# commercialista session), write StripePaymentAdapter, make it pass
# describePaymentAdapterContract, then set PAYMENT_PROVIDER=stripe.
PAYMENT_PROVIDER="mock"
# The secret the provider signs webhooks with. That signature is the only
# authentication on an endpoint that can mark bookings as paid.
PAYMENT_WEBHOOK_SECRET=""

# Reserved for the real integration. Unused while PAYMENT_PROVIDER=mock.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --------------------------------------------------------------- llm access
# ADR-012/023: consumed exclusively through LlmProvider in @bookone/core/llm.
# OpenRouter under ADR-029 (register entry SP-006). Empty key = no model: the
# orchestrator routes by rules. Model ids per tier are configuration.
OPENROUTER_API_KEY=""
LLM_MODEL_SMALL=""
LLM_MODEL_STRONG=""
# Optional. EU in-region routing (Business/Enterprise): https://eu.openrouter.ai/api/v1
OPENROUTER_BASE_URL=""

# ------------------------------------------------------------ observability
SENTRY_DSN=""
LOG_LEVEL="info"

# WhatsApp and SMS through Twilio (ADR-035). All optional; unset, those channels
# are off and the jobs log instead. Secrets: account SID and auth token.
# TWILIO_REGION=ie1 keeps Twilio's processing and log in Ireland and needs
# credentials created in IE1. TWILIO_WEBHOOK_BASE_URL is apps/api's PUBLIC URL,
# exactly as Twilio calls it (signatures cover it); locally, a tunnel's URL.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_REGION="us1"
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""
TWILIO_WEBHOOK_BASE_URL=""
# Approved WhatsApp template (Content SID HX…) for the owner's handover alert:
# {{1}} who is waiting, {{2}} the link to the conversation.
TWILIO_TEMPLATE_ESCALATION_ALERT=""

# Demo only (pnpm demo:seed): volunteers' phones to play the owner and the guest.
DEMO_OWNER_PHONE=""
DEMO_GUEST_PHONE=""
