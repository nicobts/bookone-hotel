{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "ADMIN_SUPABASE_URL",
    "ADMIN_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_APP_URL",
    "WORKER_URL",
    "API_PORT",
    "WEBHOOK_RATE_LIMIT",
    "TRUST_PROXY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_REGION",
    "TWILIO_WHATSAPP_FROM",
    "TWILIO_SMS_FROM",
    "TWILIO_WEBHOOK_BASE_URL",
    "TWILIO_TEMPLATE_ESCALATION_ALERT",
    "ALLOGGIATI_CHANNEL",
    "ALLOGGIATI_ENDPOINT",
    "ALLOGGIATI_TABLES_DIR",
    "ALLOGGIATI_SIMULATOR_USERNAME",
    "ALLOGGIATI_SIMULATOR_PASSWORD",
    "ALLOGGIATI_SIMULATOR_WSKEY",
    "WORKER_INTERNAL_TOKEN",
    "NOTIFICATION_PROVIDER",
    "PAYMENT_PROVIDER",
    "PAYMENT_WEBHOOK_SECRET",
    "APP_URL",
    "STAY_TOKEN_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "OPENROUTER_API_KEY",
    "LLM_MODEL_SMALL",
    "LLM_MODEL_STRONG",
    "OPENROUTER_BASE_URL",
    "EVAL_LIVE",
    "SENTRY_DSN",
    "LOG_LEVEL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_SERVICE_NAME",
    "OTEL_RESOURCE_ATTRIBUTES",
    "OTEL_TRACES_SAMPLER",
    "OTEL_TRACES_SAMPLER_ARG",
    "OTEL_SDK_DISABLED",
    "BOOKONE_ENVIRONMENT",
    "NEXT_RUNTIME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:rls": {
      "dependsOn": ["^build", "^test:rls"],
      "cache": false,
      "outputs": []
    },
    "test:evals": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
